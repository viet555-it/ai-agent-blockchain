# ─── LLM Provider ──────────────────────────────────────────
# Supported: gemini | anthropic | openai | fake
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model name (leave empty for provider default)
LLM_MODEL=

# ─── Blockchain (Sepolia testnet ONLY) ─────────────────────
SEPOLIA_RPC_URL=https://rpc.sepolia.org
WALLET_PRIVATE_KEY=0x_YOUR_TESTNET_PRIVATE_KEY_HERE
# Optional: needed for get_transaction_history tool
ETHERSCAN_API_KEY=

# ─── Security ──────────────────────────────────────────────
# DRY_RUN=true (default): WRITE tools simulate but never broadcast
DRY_RUN=true
MAX_STEPS=10
