# Single configuration file: copy to .env in the PROJECT ROOT.
# Process environment overrides .env. Never commit .env.
# Supported LLM providers: gemini | anthropic | openai | fake
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Explicit model for Gemini; update this when switching provider.
LLM_MODEL=gemini-3.5-flash-lite

# Integrated app on Hardhat local; explicit UI approval is required for writes.
PHASE3_PROFILE=local_evm
PHASE3_AGENT=llm
PHASE3_LOCAL_WRITES=true
LOCAL_RPC_URL=http://127.0.0.1:8545
DEFAULT_CHAIN_ID=31337
# Empty: default Hardhat account (local) or deployment owner (Sepolia).
DEMO_WALLET_ADDRESS=
PORT=8000

# Browser-wallet history: migrate the DB before setting WALLET_HISTORY_ENABLED=true.
WALLET_HISTORY_ENABLED=false
DATABASE_URL=sqlite:///data/app.db
APP_ORIGIN=http://127.0.0.1:8000
# User signs in the extension; this flag never enables a backend signer.
BROWSER_WALLET_WRITES=false

# Optional Sepolia config. No private key is needed for local.
SEPOLIA_RPC_URL=https://rpc.sepolia.org
# Standalone Agent signer, testnet only.
WALLET_PRIVATE_KEY=
# Hardhat deployment/owner scripts signer, testnet only.
PRIVATE_KEY=
# Optional: needed for get_transaction_history tool
ETHERSCAN_API_KEY=
NEW_OWNER=
SEND_OWNERSHIP_TRANSFER=false

# ─── Security ──────────────────────────────────────────────
# Standalone Agent dry-run; local approved execution uses PHASE3_LOCAL_WRITES.
DRY_RUN=true
MAX_STEPS=10
MAX_CONTEXT_TOKENS=8000
TOKEN_BUDGET_BUFFER=0.2

# RAG path overrides; model/index settings stay in config/rag.json.
RAG_INDEX_PATH=data/rag
RAG_CACHE_PATH=.cache/rag/huggingface
TIKTOKEN_CACHE_DIR=.phase3/tiktoken
