{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Agent with Blockchain Tools API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Get Health",
        "operationId": "get_health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/network/status": {
      "get": {
        "summary": "Get Network Status",
        "operationId": "get_network_status_api_network_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/network/switch": {
      "post": {
        "summary": "Switch Network",
        "operationId": "switch_network_api_network_switch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwitchNetworkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/wallet/info": {
      "get": {
        "summary": "Get Wallet Info",
        "operationId": "get_wallet_info_api_wallet_info_get",
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Address"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/guardrail/policies": {
      "get": {
        "summary": "Get Guardrail Policies",
        "operationId": "get_guardrail_policies_api_guardrail_policies_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/guardrail/audits": {
      "get": {
        "summary": "Get Audit Logs",
        "operationId": "get_audit_logs_api_guardrail_audits_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 30,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Handle Chat",
        "description": "Handle guest chats and read-only AI interactions.\n\nAuthenticated wallet sessions must use /api/history/conversations/{id}/turns.",
        "operationId": "handle_chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/approval/{approval_id}": {
      "get": {
        "summary": "Get Approval",
        "operationId": "get_approval_api_approval__approval_id__get",
        "parameters": [
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Approval Id"
            }
          },
          {
            "name": "X-Session-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Session-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/approval/action": {
      "post": {
        "summary": "Handle Approval Action",
        "operationId": "handle_approval_action_api_approval_action_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions/propose": {
      "post": {
        "summary": "Propose Transaction",
        "operationId": "propose_transaction_api_transactions_propose_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "intent": {
            "type": "string",
            "title": "Intent"
          },
          "tool_selected": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Selected"
          },
          "timeline": {
            "items": {
              "$ref": "#/components/schemas/TimelineStep"
            },
            "type": "array",
            "title": "Timeline"
          },
          "guardrail_result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GuardrailResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "rag_result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RAGSearchResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "requires_approval": {
            "type": "boolean",
            "title": "Requires Approval",
            "default": false
          },
          "approval_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Id"
          },
          "blockchain_result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Blockchain Result"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "query",
          "reply",
          "intent"
        ],
        "title": "AgentResponse",
        "description": "Standardized response from the AI Agent."
      },
      "ApprovalActionRequest": {
        "properties": {
          "approval_id": {
            "type": "string",
            "title": "Approval Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ],
            "title": "Action"
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parameters",
            "description": "Exact parameters bound to this approval"
          },
          "reviewer_comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Comment"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "approval_id",
          "action",
          "parameters"
        ],
        "title": "ApprovalActionRequest"
      },
      "ChatRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query",
            "description": "User prompt or blockchain command"
          },
          "wallet_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wallet Address",
            "description": "Optional active wallet address"
          },
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Session Id"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10
              },
              {
                "type": "null"
              }
            ],
            "title": "Language",
            "description": "Preferred response language: 'auto', 'vi', or 'en'",
            "default": "auto"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "ChatRequest"
      },
      "GuardrailResult": {
        "properties": {
          "is_allowed": {
            "type": "boolean",
            "title": "Is Allowed"
          },
          "requires_approval": {
            "type": "boolean",
            "title": "Requires Approval"
          },
          "operation": {
            "type": "string",
            "title": "Operation"
          },
          "operation_type": {
            "type": "string",
            "title": "Operation Type"
          },
          "violations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Violations"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "pending_approval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PendingApproval"
              },
              {
                "type": "null"
              }
            ]
          },
          "simulation_result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Simulation Result"
          },
          "sanitized_parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Sanitized Parameters"
          }
        },
        "type": "object",
        "required": [
          "is_allowed",
          "requires_approval",
          "operation",
          "operation_type"
        ],
        "title": "GuardrailResult",
        "description": "Structured response returned to caller/frontend on policy evaluation."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PendingApproval": {
        "properties": {
          "approval_id": {
            "type": "string",
            "title": "Approval Id"
          },
          "operation": {
            "type": "string",
            "title": "Operation"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "expires_at": {
            "type": "number",
            "title": "Expires At"
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parameters"
          },
          "parameter_hash": {
            "type": "string",
            "title": "Parameter Hash"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "PENDING"
          },
          "reviewed_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewed At"
          },
          "reviewer_comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Comment"
          },
          "tx_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tx Hash"
          }
        },
        "type": "object",
        "required": [
          "operation",
          "expires_at",
          "parameters",
          "parameter_hash",
          "description"
        ],
        "title": "PendingApproval",
        "description": "Represents a write transaction pending explicit human approval."
      },
      "ProposalRequest": {
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "native_transfer",
              "erc20_transfer",
              "faucet_claim"
            ],
            "title": "Operation"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "recipient": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recipient"
          },
          "token_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Token Address"
          },
          "wallet_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wallet Address"
          },
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation",
          "amount",
          "session_id"
        ],
        "title": "ProposalRequest"
      },
      "RAGSearchResult": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "retrieval_query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieval Query"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/RetrievedDocument"
            },
            "type": "array",
            "title": "Documents"
          },
          "has_relevant_context": {
            "type": "boolean",
            "title": "Has Relevant Context",
            "default": false
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "default": "curated_knowledge_adapter"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "RAGSearchResult",
        "description": "Result of context retrieval for an agent query."
      },
      "RetrievedDocument": {
        "properties": {
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "source_file": {
            "type": "string",
            "title": "Source File"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Score",
            "default": 0.9
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "doc_id",
          "title",
          "source_file",
          "excerpt"
        ],
        "title": "RetrievedDocument",
        "description": "Represents a chunk of retrieved knowledge context."
      },
      "SwitchNetworkRequest": {
        "properties": {
          "chain_id": {
            "type": "integer",
            "title": "Chain Id"
          }
        },
        "type": "object",
        "required": [
          "chain_id"
        ],
        "title": "SwitchNetworkRequest"
      },
      "TimelineStep": {
        "properties": {
          "step_number": {
            "type": "integer",
            "title": "Step Number"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "timestamp": {
            "type": "number",
            "title": "Timestamp"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "tool_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Name"
          },
          "sanitized_parameters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sanitized Parameters"
          },
          "result": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "step_number",
          "name",
          "status"
        ],
        "title": "TimelineStep",
        "description": "Step in the 9-stage Agent workflow timeline."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
